<?xml version="1.0" encoding="utf-8"?>

<!-- Constraint for entire page -->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- Start Header -->
    <FrameLayout
        android:id="@+id/frame_header"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/lightGray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay" />


        <TextView
            android:id="@+id/text_view_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="Lifting"
            android:textSize="44sp" />
    </FrameLayout>
    <!-- End Header -->


    <!-- Exercises -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_exercises"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/button_finish_workout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frame_header"
        tools:listitem="@layout/item_exercise_log_for_lifting_fragment">




    </androidx.recyclerview.widget.RecyclerView>


<!---
    <Button
        android:id="@+id/button_add_exercise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Exercise"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/recycler_view_exercises"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_finish_workout" />
-->

    <Button
        android:id="@+id/button_finish_workout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Finish Workout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>


